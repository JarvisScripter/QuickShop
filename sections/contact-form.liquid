<div class="flex flex-col items-center my-8">
    {% unless section.settings.title == empty %}
        <h1 class="text-3xl font-medium text-gray-900 text-center mb-3">
            {{ section.settings.title }}
        </h1>
    {% endunless %}
    {% form 'contact' %}
        {% if form.errors %}
            <div class="text-red-500 mb-4">
                {{ form.errors.messages | first }}
            </div>
        {% endif %}
        {% if form.posted_successfully? %}
            <div class="text-green-500 mb-4">
                Message has been sent successfully.
            </div>
        {% endif %}
        <div class="max-w-7xl mx-auto justify-center flex-1 items-center px-4">
            <div class="flex px-1 mb-3">
                <div class="px-3 md:w-1/2">
                    <label class="uppercase text-sm text-gray-500 font-medium" for="contact_name">Name</label>
                    <input class="border py-3 px-4 mb-3 text-gray-700 w-full" type="text" name="contact[name]" id="contact_name">
                </div>
                
                <div class="px-3 md:w-1/2">
                    <label class="uppercase text-sm text-gray-500 font-medium" for="contact_email">Email</label>
                    <input class="border py-3 px-4 mb-3 text-gray-700 w-full" type="email" name="contact[email]" id="contact_email">
                </div>
            </div>

            <div class="flex px-1 mb-3">
                <div class="w-full px-3">
                    <label class="uppercase text-sm text-gray-500 font-medium" for="contact_message">Message</label>
                    <textarea class="border py-3 px-4 mb-3 text-gray-700 w-full" name="contact[body]" id="contact_message"></textarea>
                </div>
            </div>
            <div class="flex px-1 mb-3">
                <div class="w-full px-3">
                    <input type="submit" class="w-full cursor-pointer px-4 py-3 font-medium text-white bg-gray-900  hover:bg-gray-700" value="Submit Message">
                </div>
            </div>
        </div>
    {% endform %}
</div>

{% schema %}
{
    "name": "Contact Form",
    "settings": [
        {
            "type": "text",
            "label": "Title",
            "id": "title"
        }
    ],
    "presets": [
        {
            "name": "Contact Form"
        }
    ]
}
{% endschema %}