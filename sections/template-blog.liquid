<div class="p-8">
    {% paginate blog.articles by section.settings.articles_per_page %}
        <h1 class="text-gray-900 text-3xl font-semibold text-center"> {{ blog.title }}</h1>
        {% comment %} each row should have 3 cards {% endcomment %}
         <div class="max-w-7xl mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
                {% for article in blog.articles %}
                    <div class="bg-gray-50 rounded-3xl shadow-xl overflow-hidden">
                        {% if article.image %}
                            <img class="w-full h-80 object-cover" src="{{article.image |  img_url: 'medium'}}" alt="{{article.image.alt}}">
                        {% else %}
                            {{ 'image' | placeholder_svg_tag: 'w-full h-80 object-cover bg-gray-100' }}        
                        {% endif %}

                        <div class="p-4">
                            <h1 class="text-xl font-medium my-4"> {{ article.title }}</h1>
                            
                            {% if article.excerpt.size > 0 %}
                                <p> {{ article.excerpt | strip_html |  truncatewords: 15 }}</p>
                                {% else %}
                                <p> {{ article.content |  strip_html |  truncatewords: 15 }}</p>
                            {% endif %}
                            <a href="{{ article.url }}" class="text-blue-500 hover:underline my-4 block">{{ section.settings.blog_read_more }}</a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {% render 'pagination', paginate: paginate %}
    {% endpaginate %}

</div>

{% schema %}
{
    "name": "Blog",
    "settings": [
            {
                "type": "text",
                "id": "blog_read_more",
                "label": "Read more button text",
                "default": "Read more"
            },
            {
                "type": "range",
                "id": "articles_per_page",
                "label": "Articles per page",
                "step": 1,
                "min": 1,
                "max": 6,
                "default": 3
            }
        ]
}
{% endschema %}