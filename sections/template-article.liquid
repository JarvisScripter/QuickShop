<article class="py-8" itemscope itemtype="http://schema.org/BlogPosting">
    {% for block in section.blocks %}
        {% case block.type %}
            {% when 'article_title' %}
                <div class="flex items-center justify-center mb-4">
                    <div class="max-w-7xl text-center">
                        <a href={{blog.url}} class="text-grey-500 hover:text-gray-900 uppercase font-bold">{{blog.title}}</a>
                        <h1 class="text-4xl md:text-6xl font-medium" itemprop="headline">
                            {{ section.settings.title }}
                        </h1>
                    </div>
                </div>
            {% when 'article_author' %}
                <div class="flex items-center justify-center mb-4">
                    <div class="max-w-7xl text-center" itemscope itemtype="http://schema.org/Person">
                        {% if section.settings.display_author %}
                            <small itemprop="author">{{ article.author }} </small>
                        {% endif %}
                    </div>
                </div>
            {% when 'published_date' %}
                <div class="flex items-center justify-center mb-4">
                    <div class="max-w-7xl text-center">
                        {% if section.settings.display_date %}
                            <time itemprop="datePublished dateCreated">Published {{ article.created_at | date: format: 'on_date'}}</time> 
                        {% endif %}
                    </div>
                </div>
            {% when 'featured_image' %}
                <div class="max-w-7xl bg-blue-100 mx-2 md:mx-auto my-5 rounded-4xl overflow-hidden" itemprop="image">
                {% if article.image != empty %}
                    <img class="w-full h-80 md:h-96 object-cover object-center" src="{{ article.image | img_url: 'large' }}" alt="{{ article.image.alt }}">
                {% else %}
                    {% assign placeholder_image = 'lifestyle-2' %}
                    {{ placeholder_image | placeholder_svg_tag: 'w-full h-80 md:h-96 object-cover object-center' }}
                {% endif %}
                </div>
            {% when 'article_content' %}
                 <div class="flex items-center justify-center mb-4">
                    <div class="max-w-5xl" itemprop="articleBody">
                        {% if article.excerpt.size > 0 %}
                            {{ article.excerpt }}
                        {% else %}
                            {{ article.content }}
                        {% endif %}
                    </div>
                </div>    
        {% endcase %}
    {% endfor %}
</article>

{% if blog.comments_enabled? %}
    {% if article.comments_count > 0 %}
        <div class="flex-1 items-center justify-center max-w-5xl mx-auto">
            <h2 class="text-2xl font-bold mb-4">See what people are saying ...</h2>
        
            {% paginate article.comments by 5 %}
                {% for comment in article.comments %}
                    <div class="flex-1 border my-4 px-4 py-2 sm:px-6 sm:py-4 leading-relaxed">
                        <span class="text-gray-900">{{comment.author}}</span> <span class="text-gray-600 text-xs">{{comment.created_at |  date: format: 'default'}}</span>
                        <p class="text-gray-900">{{comment.content}}</p> 
                    </div>
                {% endfor %}

                {% if paginate.pages > 1 %}
                    {{paginate| default_pagination}}
                {% endif %}
            {% endpaginate %}
        </div>
    {% endif %}

    <div id="comment_form" class="mb-8">
        {% form 'new_comment', article %}
            <div class="flex-1 mx-auto items-center justify-center max-w-5xl">
                {% if form.errors %}
                    <div class="text-red-500 mb-4">
                        {{ form.errors.messages | first }}
                    </div>
                {% endif %}
                {% if form.posted_successfully? %}
                    <div class="text-green-500 mb-4">
                        Your comment has been posted successfully.
                    </div>
                {% endif %}
                <div class="px-1 md:flex mb-3">
                    <div class="px-3 w-full md:w-1/2">
                        <label for="comment_author" class="text-gray-700 uppercase font-medium text-xs mb-2">Name</label>
                        <input type="text" id="comment_author" name="comment[author]" placeholder="Jane Doe" class="w-full text-gray-700 border font-medium py-3 px-4 mb-2" required>
                    </div>
                    <div class="px-3 w-full md:w-1/2">
                        <label for="comment_email" class="text-gray-700 uppercase font-medium text-xs mb-2">Email</label>
                        <input type="email" id="comment_email" name="comment[email]" placeholder="jane.doe@example.com" class="w-full text-gray-700 border font-medium py-3 px-4 mb-2" required>
                    </div>
                </div>
                <div class="px-3">
                    <label for="comment_body" class="text-gray-700 uppercase font-medium text-xs mb-2">Comment</label>
                    <textarea id="comment_body" name="comment[body]" class="w-full text-gray-700 border font-medium py-3 px-4 mb-2 resize-none" required></textarea>
                </div>
                <div class="px-3">
                    <input type="submit" class="px-4 py-2 w-full bg-gray-900 hover:bg-gray-600 text-white rounded-md cursor-pointer" value="Submit Comment">
                </div>
            </div>
        {% endform %}
    </div>
{% endif %}

<script type="application/ld+json">
    {
        "@context": "http://schema.org",
        "@type": "BlogPosting",
        "headline": {{article.title |  json}},
        "articleBody": {{article.content |  strip_html |  json}},
        {% if article.excerpt != empty %}
            "description": {{article.excerpt | strip_html | json}},
        {% endif %}
        "datePublished": {{article.published_at | date: format: "default" | json}},
        "dateCreated": {{article.created_at | date: format: "default" | json}},
        "author": {
            "@type": "Person",
            "name": {{article.author | json}}
        },
        "publisher": {
            "@type": "Organization",
            "name": {{shop.name | json}}
        }
    }
</script>

{% schema %}
{
    "name": "Article Template",
    "settings": [
            {
                "type": "text",
                "id": "title",
                "default": "My Article Template",
                "label": "Article Title",
                "info": "This is the title of the article template. It will be displayed in the theme editor and can be used to identify this template when assigning it to articles."
            },
            {
                "type": "checkbox",
                "id": "display_author",
                "default": true,
                "label": "Display Author",
                "info": "Check this box to display the author of the article on the article page. If unchecked, the author will not be shown."
            },
            {
                "type": "checkbox",
                "id": "display_date",
                "default": true,
                "label": "Display Date",
                "info": "Check this box to display the publication date of the article on the article page. If unchecked, the date will not be shown."
            }
        ],
        "blocks": [
            {
                "type": "article_title",
                "name": "Article Title",
                "limit": 1
            },
            {
                "type": "article_author",
                "name": "Article Author",
                "limit": 1
            },
            {
                "type": "published_date",
                "name": "Published Date",
                "limit": 1
            },
            {
                "type": "featured_image",
                "name": "Thumbnail Image",
                "limit": 1
            },
            {
                "type": "article_content",
                "name": "Article Content",
                "limit": 1
            }
        ]
}
{% endschema %}