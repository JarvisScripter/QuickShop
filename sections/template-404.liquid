<div>
    <div class="min-h-screen bg-white flex flex-col justify-center items-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{{ section.settings.title }}</h1>
        <p class="text-lg text-gray-500 mb-8">{{ section.settings.subtext }}</p>
        {% if section.settings.go_back_home_url == empty %}
            {% assign shop_url = shop.secure_url %}
        {% else %}
            {% assign shop_url = section.settings.go_back_home_url %}
        {% endif %}
        <a href="{{ shop_url }}" class="px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700">{{ section.settings.go_back_home }}</a>
    </div>
</div>

{% schema %}
{
    "name": "Template 404",
    "settings": [
            {
                "type": "text",
                "id": "title",
                "default": "Not found",
                "label": "404 Title",
            },
            {
                "type": "text",
                "id": "subtext",
                "default": "The page you were looking for does not exist",
                "label": "404 Subtext Title"
            },
            {
                "type": "text",
                "id": "go_back_home",
                "default": "Go back home",
                "label": "404 Go Back Home Text"
            },
            {
                "type": "url",
                "id": "go_back_home_url",
                "label": "404 Go Back Home URL"
            }
        ]
}
{% endschema %}