{% if paginate.pages > 1 %}
    <nav role="navigation" class="flex justify-center my-8">
        {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="border text-gray-600 hover:text-white hover:bg-gray-600 px-4 py-2 mx-2 rounded font-medium"> {{ paginate.previous.title }} </a>
        {% endif %}

        {% for part in paginate.parts %}
            {% if part.is_link %}
                <a href="{{ part.url }}" class="border text-gray-600 hover:text-white hover:bg-gray-600 px-4 py-2 mx-2 rounded font-medium"> {{ part.title }} </a>
            {% else %}
                <span class="border bg-gray-600 text-white px-4 py-2 mx-2 rounded font-medium"> {{ part.title }} </span>
            {% endif %}
        {% endfor %}

        {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="border text-gray-600 hover:text-white hover:bg-gray-600 px-4 py-2 mx-2 rounded font-medium"> {{ paginate.next.title }} </a>
        {% endif %}
    </nav>
{% endif %}