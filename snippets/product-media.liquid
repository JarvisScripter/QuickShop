{% case media.media_type %}
    {% when "image" %}
        <img src="{{ media | img_url: 'large' }}" alt="{{ media.preview_image.alt | escape }}" class="w-full h-80 object-cover rounded-lg">
    {% when "external_video" %}
        {{ media | external_video_tag: class: "w-full h-80 object-cover" }}
    {% when "video" %}
        {{ media | video_tag: class: "w-full h-80 object-cover", controls: true }}
    {% when "model" %}
        {{ media |  model_viewer_tag }}
    {% else %}
        {{ media |  media_tag }}
{% endcase %}