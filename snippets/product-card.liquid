<div class="my-6 mx-3 w-full bg-gray-50 shadow-lg rounded-lg overflow-hidden">
    <a href="{{ product.url }}">
        {% if product.featured_image %}
            <img class="w-full h-80 object-cover hover:scale-105 transition-transform duration-300" src="{{ product.featured_image |  img_url: 'medium' }}" alt="{{ product.featured_image.alt }}">
        {% else %}
            {{ 'product-2' |  placeholder_svg_tag: 'w-full h-80 object-cover bg-gray-100 hover:scale-105 transition-transform duration-300' }}
        {% endif %}
    </a>
    <div class="my-2 px-4 flex flex-col justify-between">
        <h2 class="text-md text-gray-900 font-medium">{{ product.title }} {% if section.settings.show_vendor %} <span class="text-sm text-gray-600 ml-3">{{ product.vendor }}</span>{% endif %}</h2>
        <p>{{ product.price | money }}</p>
        {% if product.variants.size > 1 %}
            <div class="my-4 py-2 rounded-lg max-w-md">
                <div class="flex items-center justify-start gap-2 overflow-auto">
                    {% for variant in product.variants %}
                        <div class="px-4 py-3 bg-gray-100 rounded-lg shrink-0">
                            <p>{{ variant.title }}</p>
                            <p>{{ variant.price | money }}</p>
                            </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
</div>
